# justfile — config-reporter recipes

# Default recipe
default:
    @just --list

# Typecheck the report schema
build:
    nickel typecheck src/report.ncl
    nickel typecheck src/rules.ncl
    @echo "Schema files typecheck OK"

# Run the reporter on the parent monorepo
test:
    ./bin/config-reporter ../augmented/
    @echo "Reporter test passed"

# Run reporter in JSON mode and validate output with jq
test-json:
    ./bin/config-reporter --json ../augmented/ 2>/dev/null | jq . > /dev/null
    @echo "JSON output valid"

# Lint — check the reporter script with shellcheck
lint:
    @command -v shellcheck >/dev/null && shellcheck bin/config-reporter || echo "shellcheck not found (optional)"

# Format (no-op for bash scripts)
fmt:
    @echo "No formatter configured for bash scripts"

# Clean build artifacts
clean:
    @echo "Nothing to clean"
